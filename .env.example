# Copy this file to .env and fill it in. Never commit .env to GitHub.
ANTHROPIC_API_KEY=sk-ant-...
OWNER_NAME=Your Name
TIMEZONE=Australia/Brisbane

# Apple Calendar (iCloud): create an app-specific password at appleid.apple.com
ICLOUD_EMAIL=you@icloud.com
ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
ICLOUD_CALENDAR_NAME=Calendar

# GitHub: fine-grained token with Contents + Pull requests (read/write) on your repo
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=your-username/your-project
REPO_PATH=~/code/your-project

# WordPress: Users > Profile > Application Passwords > add "Daniel Corp"
WP_URL=https://yoursite.com
WP_USERNAME=your-wordpress-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: VERBOSE=1 prints every tool call
VERBOSE=1

# Optional: warn when monthly API spend passes this (USD)
MONTHLY_BUDGET_USD=20
